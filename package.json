{
  "name": "gpt-live-avatar",
  "version": "0.2.3",
  "description": "Tia, a full-duplex desk avatar on OpenAI GPT-Live-1",
  "author": "Adam Cohen",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node qa/qa.js && node qa/asset-revisions.cjs && node qa/controls.cjs && node qa/delegate.cjs && node qa/group.cjs && node qa/attention.cjs && node qa/group-live.cjs && node qa/render-budget.cjs && node qa/agent.cjs && node qa/protected-assets.cjs",
    "pack": "electron-builder --mac dir",
    "dmg": "bash tools/dmg.sh",
    "fetch-assets": "bash tools/fetch-assets.sh",
    "build-protected-assets": "node tools/build-protected-assets.cjs",
    "prepack": "node tools/verify-release.cjs",
    "predmg": "node tools/verify-release.cjs"
  },
  "dependencies": {
    "openai": "^7.15.0"
  },
  "devDependencies": {
    "aws4fetch": "^1.0.20",
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.adamcohen.gptliveavatar",
    "productName": "GPT-Live Avatar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "web/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSMinimumSystemVersion": "14.0",
        "NSMicrophoneUsageDescription": "GPT-Live Avatar uses the microphone only during a live conversation; ending the conversation stops capture.",
        "NSAppleEventsUsageDescription": "When you ask about a webpage, GPT-Live Avatar reads the current browser tab to answer using its contents."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "notarize": true
    },
    "extraResources": [
      {
        "from": "build/protected/index.json",
        "to": "assets-index.json"
      },
      {
        "from": "build/protected/assets-runtime.json",
        "to": "assets-runtime.json"
      },
      {
        "from": "build/protected/starter/tia/base.gla",
        "to": "avatars/tia/base.gla"
      }
    ],
    "dmg": {
      "writeUpdateInfo": false,
      "sign": true
    }
  }
}
