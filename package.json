{
  "name": "gpt-live-avatar",
  "version": "0.1.0",
  "description": "Tia, a full-duplex desk avatar on OpenAI GPT-Live-1",
  "author": "Adam Cohen",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node qa/qa.js",
    "pack": "electron-builder --mac dir",
    "dmg": "electron-builder --mac dmg",
    "fetch-assets": "bash tools/fetch-assets.sh"
  },
  "dependencies": {
    "openai": "^7.15.0"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.adamcohen.gptliveavatar",
    "productName": "GPT-Live Avatar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "web/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSMinimumSystemVersion": "14.0",
        "NSMicrophoneUsageDescription": "GPT-Live Avatar uses the microphone only during a live conversation; ending the conversation stops capture."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true
    },
    "extraResources": [
      {
        "from": "build/assets/bundle/tia",
        "to": "avatars/tia"
      },
      {
        "from": "build/assets/index.json",
        "to": "assets-index.json"
      }
    ],
    "dmg": {
      "writeUpdateInfo": false
    }
  }
}
