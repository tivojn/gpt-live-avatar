{
  "name": "gpt-live-avatar",
  "version": "0.2.17",
  "description": "GPT-Live Avatar, a full-duplex desktop companion on OpenAI GPT-Live-1",
  "author": "Adam Cohen",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node qa/qa.js && node qa/asset-revisions.cjs && node qa/controls.cjs && node qa/shortcuts.cjs && node qa/zoom.cjs && node qa/body-brief-hooks.cjs && node qa/delegate.cjs && node qa/group.cjs && node qa/show.cjs && node qa/attention.cjs && node qa/group-live.cjs && node qa/render-budget.cjs && node qa/agent.cjs && node qa/codex-agent.cjs && node qa/agent-progress.cjs && node qa/protected-assets.cjs && node qa/import-release.cjs && node qa/lip-sync.cjs && node qa/agent-runtimes.cjs && node qa/releases.cjs && node qa/agent-composer.cjs && node qa/agent-folder.cjs && node qa/path-display.cjs",
    "pack": "electron-builder --mac dir",
    "dmg": "bash tools/dmg.sh",
    "fetch-assets": "bash tools/fetch-assets.sh",
    "build-protected-assets": "node tools/build-protected-assets.cjs",
    "prepack": "node tools/verify-release.cjs",
    "predmg": "node tools/verify-release.cjs",
    "import-release": "node tools/import-release.cjs",
    "start:isolated": "node tools/start-isolated.cjs",
    "prepack:local": "node tools/verify-release.cjs",
    "pack:local": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir -c.mac.identity=null -c.mac.notarize=false",
    "predmg:local": "node tools/verify-release.cjs",
    "dmg:local": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg -c.mac.identity=null -c.mac.notarize=false -c.dmg.sign=false"
  },
  "dependencies": {
    "openai": "^7.15.0"
  },
  "devDependencies": {
    "aws4fetch": "^1.0.20",
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.adamcohen.gptliveavatar",
    "productName": "GPT-Live Avatar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "web/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSMinimumSystemVersion": "14.0",
        "NSMicrophoneUsageDescription": "GPT-Live Avatar uses the microphone only during a live conversation; ending the conversation stops capture."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "notarize": true
    },
    "extraResources": [
      {
        "from": "build/protected/index.json",
        "to": "assets-index.json"
      },
      {
        "from": "build/protected/assets-runtime.json",
        "to": "assets-runtime.json"
      },
      {
        "from": "build/protected/starter/sarah/base.gla",
        "to": "avatars/sarah/base.gla"
      },
      {
        "from": "build/protected/starter/sarah/motions.gla",
        "to": "avatars/sarah/motions.gla"
      }
    ],
    "dmg": {
      "writeUpdateInfo": false,
      "sign": true
    }
  }
}
